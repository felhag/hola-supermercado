{ "id": "conjugations", "cards": [
{ "id": "cj01", "text": "Yo ___ español todos los días.", "answer": "hablo", "es": "Yo hablo español todos los días.", "en": "I speak Spanish every day.", "choices": ["hablo", "hablas", "habla", "hablamos"], "note": "-ar verb, yo form" },
{ "id": "cj02", "text": "Tú ___ mucho en la oficina.", "answer": "trabajas", "es": "Tú trabajas mucho en la oficina.", "en": "You work a lot at the office.", "choices": ["trabajas", "trabajo", "trabaja", "trabajáis"], "note": "-ar verb, tú form" },
{ "id": "cj03", "text": "Nosotros ___ pan en el supermercado.", "answer": "compramos", "es": "Nosotros compramos pan en el supermercado.", "en": "We buy bread at the supermarket.", "choices": ["compramos", "compran", "compro", "compráis"], "note": "-ar verb, nosotros form" },
{ "id": "cj04", "text": "Ellos ___ en la universidad.", "answer": "estudian", "es": "Ellos estudian en la universidad.", "en": "They study at the university.", "choices": ["estudian", "estudia", "estudiamos", "estudias"], "note": "-ar verb, ellos form" },
{ "id": "cj05", "text": "Yo ___ fruta por la mañana.", "answer": "como", "es": "Yo como fruta por la mañana.", "en": "I eat fruit in the morning.", "choices": ["como", "comes", "come", "comemos"], "note": "-er verb, yo form" },
{ "id": "cj06", "text": "Ella ___ café sin azúcar.", "answer": "bebe", "es": "Ella bebe café sin azúcar.", "en": "She drinks coffee without sugar.", "choices": ["bebe", "bebo", "beben", "bebemos"], "note": "-er verb, ella form" },
{ "id": "cj07", "text": "Nosotros ___ mucho en clase.", "answer": "aprendemos", "es": "Nosotros aprendemos mucho en clase.", "en": "We learn a lot in class.", "choices": ["aprendemos", "aprenden", "aprendo", "aprendéis"], "note": "-er verb, nosotros form" },
{ "id": "cj08", "text": "Vosotros ___ el periódico.", "answer": "leéis", "es": "Vosotros leéis el periódico.", "en": "You all read the newspaper.", "choices": ["leéis", "leen", "leemos", "lees"], "note": "-er verb, vosotros form" },
{ "id": "cj09", "text": "Yo ___ en Madrid.", "answer": "vivo", "es": "Yo vivo en Madrid.", "en": "I live in Madrid.", "choices": ["vivo", "vives", "vive", "vivimos"], "note": "-ir verb, yo form" },
{ "id": "cj10", "text": "Tú ___ un correo a tu jefe.", "answer": "escribes", "es": "Tú escribes un correo a tu jefe.", "en": "You write an email to your boss.", "choices": ["escribes", "escribo", "escribe", "escribís"], "note": "-ir verb, tú form" },
{ "id": "cj11", "text": "La tienda ___ a las nueve.", "answer": "abre", "es": "La tienda abre a las nueve.", "en": "The shop opens at nine.", "choices": ["abre", "abro", "abren", "abrimos"], "note": "-ir verb, third person singular" },
{ "id": "cj12", "text": "Nosotros ___ las escaleras.", "answer": "subimos", "es": "Nosotros subimos las escaleras.", "en": "We go up the stairs.", "choices": ["subimos", "suben", "subo", "subís"], "note": "-ir verb, nosotros form" },
{ "id": "cj13", "text": "Yo ___ profesor.", "answer": "soy", "es": "Yo soy profesor.", "en": "I am a teacher.", "choices": ["soy", "estoy", "es", "son"], "note": "ser for a profession" },
{ "id": "cj14", "text": "Ustedes ___ muy amables.", "answer": "son", "es": "Ustedes son muy amables.", "en": "You all are very kind.", "choices": ["son", "están", "somos", "es"], "note": "ser for what someone is like" },
{ "id": "cj15", "text": "Nosotros ___ en el mercado.", "answer": "estamos", "es": "Nosotros estamos en el mercado.", "en": "We are at the market.", "choices": ["estamos", "somos", "están", "estás"], "note": "estar for location" },
{ "id": "cj16", "text": "¿Cómo ___ tú hoy?", "answer": "estás", "es": "¿Cómo estás tú hoy?", "en": "How are you today?", "choices": ["estás", "eres", "está", "estáis"], "note": "estar for how you feel" },
{ "id": "cj17", "text": "Yo ___ dos hermanas.", "answer": "tengo", "es": "Yo tengo dos hermanas.", "en": "I have two sisters.", "choices": ["tengo", "tienes", "tiene", "tenemos"], "note": "tener, the yo form is irregular" },
{ "id": "cj18", "text": "Él ___ treinta años.", "answer": "tiene", "es": "Él tiene treinta años.", "en": "He is thirty years old.", "choices": ["tiene", "tengo", "tienen", "tenemos"], "note": "age uses tener, not ser" },
{ "id": "cj19", "text": "Nosotros ___ al cine el sábado.", "answer": "vamos", "es": "Nosotros vamos al cine el sábado.", "en": "We go to the cinema on Saturday.", "choices": ["vamos", "van", "voy", "vais"], "note": "ir, nosotros form" },
{ "id": "cj20", "text": "Yo ___ a la playa mañana.", "answer": "voy", "es": "Yo voy a la playa mañana.", "en": "I am going to the beach tomorrow.", "choices": ["voy", "vas", "va", "vamos"], "note": "ir, yo form" },
{ "id": "cj21", "text": "Yo ___ la cena los domingos.", "answer": "hago", "es": "Yo hago la cena los domingos.", "en": "I make dinner on Sundays.", "choices": ["hago", "haces", "hace", "hacemos"], "note": "hacer, the yo form is irregular" },
{ "id": "cj22", "text": "¿___ ayudarme, por favor?", "answer": "Puedes", "es": "¿Puedes ayudarme, por favor?", "en": "Can you help me, please?", "choices": ["Puedes", "Puedo", "Podéis", "Pueden"], "note": "poder, tú form, o changes to ue" },
{ "id": "cj23", "text": "Ellos ___ ir al museo.", "answer": "quieren", "es": "Ellos quieren ir al museo.", "en": "They want to go to the museum.", "choices": ["quieren", "quiere", "queremos", "quieres"], "note": "querer, e changes to ie" },
{ "id": "cj24", "text": "Yo ___ de Alemania.", "answer": "vengo", "es": "Yo vengo de Alemania.", "en": "I come from Germany.", "choices": ["vengo", "vienes", "viene", "venimos"], "note": "venir, the yo form is irregular" },
{ "id": "cj25", "text": "Tú siempre ___ la verdad.", "answer": "dices", "es": "Tú siempre dices la verdad.", "en": "You always tell the truth.", "choices": ["dices", "digo", "dice", "decís"], "note": "decir, e changes to i" },
{ "id": "cj26", "text": "Yo no ___ dónde está la estación.", "answer": "sé", "es": "Yo no sé dónde está la estación.", "en": "I do not know where the station is.", "choices": ["sé", "sabes", "sabe", "sabemos"], "note": "saber, the yo form is irregular" },
{ "id": "cj27", "text": "Nosotros ___ una película esta noche.", "answer": "vemos", "es": "Nosotros vemos una película esta noche.", "en": "We are watching a film tonight.", "choices": ["vemos", "ven", "veo", "veis"], "note": "ver, nosotros form" },
{ "id": "cj28", "text": "Ella me ___ un regalo.", "answer": "da", "es": "Ella me da un regalo.", "en": "She gives me a present.", "choices": ["da", "doy", "dan", "damos"], "note": "dar, ella form" },
{ "id": "cj29", "text": "Yo me ___ a las siete.", "answer": "levanto", "es": "Yo me levanto a las siete.", "en": "I get up at seven.", "choices": ["levanto", "levantas", "levanta", "levantamos"], "note": "reflexive verb, yo form" },
{ "id": "cj30", "text": "El niño ___ a las nueve.", "answer": "duerme", "es": "El niño duerme a las nueve.", "en": "The child sleeps at nine.", "choices": ["duerme", "duermo", "duermen", "dormimos"], "note": "dormir, o changes to ue" },
{ "id": "cj31", "text": "Nosotros ___ ir al parque si hace sol.", "answer": "podemos", "es": "Nosotros podemos ir al parque si hace sol.", "en": "We can go to the park if it is sunny.", "choices": ["podemos", "pueden", "puedo", "podéis"], "note": "poder, the nosotros form keeps the o" },
{ "id": "cj32", "text": "Ella está ___ en la cocina.", "answer": "cocinando", "es": "Ella está cocinando en la cocina.", "en": "She is cooking in the kitchen.", "choices": ["cocinando", "cocina", "cocinado", "cocinar"], "note": "estar plus -ndo for what is happening right now" },
{ "id": "cj33", "text": "Yo ___ comido ya.", "answer": "he", "es": "Yo he comido ya.", "en": "I have already eaten.", "choices": ["he", "ha", "has", "hemos"], "note": "haber plus the participle makes the perfect" },
{ "id": "cj34", "text": "Ayer yo ___ paella.", "answer": "comí", "es": "Ayer yo comí paella.", "en": "Yesterday I ate paella.", "choices": ["comí", "como", "comió", "comemos"], "note": "preterite, yo form of comer" },
{ "id": "cj35", "text": "Ayer yo ___ con el médico.", "answer": "hablé", "es": "Ayer yo hablé con el médico.", "en": "Yesterday I spoke with the doctor.", "choices": ["hablé", "hablo", "habló", "hablamos"], "note": "preterite, yo form of hablar" },
{ "id": "cj36", "text": "Yo ___ en Sevilla dos años.", "answer": "viví", "es": "Yo viví en Sevilla dos años.", "en": "I lived in Seville for two years.", "choices": ["viví", "vivo", "vivió", "vivimos"], "note": "preterite, yo form of vivir" },
{ "id": "cj37", "text": "Anoche nosotros ___ una película.", "answer": "vimos", "es": "Anoche nosotros vimos una película.", "en": "Last night we watched a film.", "choices": ["vimos", "vemos", "vieron", "vi"], "note": "preterite of ver" },
{ "id": "cj38", "text": "El año pasado ella ___ a España.", "answer": "fue", "es": "El año pasado ella fue a España.", "en": "Last year she went to Spain.", "choices": ["fue", "va", "fui", "fueron"], "note": "preterite of ir, the same forms as ser" },
{ "id": "cj39", "text": "Ayer tú ___ mucho trabajo.", "answer": "tuviste", "es": "Ayer tú tuviste mucho trabajo.", "en": "Yesterday you had a lot of work.", "choices": ["tuviste", "tienes", "tuvo", "tuvimos"], "note": "preterite of tener" },
{ "id": "cj40", "text": "Ayer ellos ___ tarde.", "answer": "llegaron", "es": "Ayer ellos llegaron tarde.", "en": "Yesterday they arrived late.", "choices": ["llegaron", "llegan", "llegó", "llegamos"], "note": "preterite, ellos form of llegar" },
{ "id": "cj41", "text": "Cuando era niño, yo ___ mucho al fútbol.", "answer": "jugaba", "es": "Cuando era niño, yo jugaba mucho al fútbol.", "en": "When I was a child, I played football a lot.", "choices": ["jugaba", "jugué", "juego", "jugaban"], "note": "imperfect for what you used to do" },
{ "id": "cj42", "text": "Mañana yo ___ a mi madre.", "answer": "llamaré", "es": "Mañana yo llamaré a mi madre.", "en": "Tomorrow I will call my mother.", "choices": ["llamaré", "llamo", "llamaría", "llamará"], "note": "future, yo form" }
] }
