# Editor configuration, see https://editorconfig.org
root = true

[*]
charset = utf-8
indent_style = space
indent_size = 2
insert_final_newline = true
trim_trailing_whitespace = true
# Not set in lastfm-stats-web, pinned here because the service worker's build
# stamp hashes file bytes: a CRLF checkout would change every hash.
end_of_line = lf

[*.md]
max_line_length = off
trim_trailing_whitespace = false
